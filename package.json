{
  "name": "kalivra",
  "version": "1.0.1",
  "description": "Kalivra Application",
  "main": "main.js",
  "author": "Bawky <ghini7170@gmail.com>",
  "license": "ISC",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "test": "node --test",
    "prebuild:win": "npm run build:renderer",
    "build:win": "electron-builder --win",
    "prebuild:linux": "npm run build:renderer",
    "build:linux": "electron-builder --linux",
    "prebuild:mac": "npm run build:renderer",
    "build:mac": "electron-builder --mac",
    "prebuild:all": "npm run build:renderer",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "productName": "Kalivra",
    "appId": "com.Bawky.kalivra",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/AppIcon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kalivra",
      "installerIcon": "assets/AppIcon.ico",
      "uninstallerIcon": "assets/AppIcon.ico",
      "uninstallDisplayName": "Kalivra (Bawky)",
      "runAfterFinish": true
    },
    "files": [
      ".generated/renderer.js",
      "assets/**/*",
      "css/**/*",
      "src/domain/projectDocument.js",
      "src/main/**/*",
      "src/shared/**/*",
      "index.html",
      "main.js",
      "package.json",
      "preload.js"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/AppIcon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/AppIcon.png",
      "category": "Development",
      "maintainer": "Bawky <ghini7170@gmail.com>"
    }
  },
  "devDependencies": {
    "chart.js": "^4.5.1",
    "core-util-is": "^1.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "firebase": "^12.7.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "protobufjs": "7.6.5",
    "websocket-driver": "0.7.5"
  }
}
